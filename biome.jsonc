{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.{mts,mjs,ts,tsx,css,js,json,yaml,md}",
      "!**/.wesven",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "all",
      "project": "all"
    },
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useImportExtensions": "off",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        },
        "noArrayIndexKey": "info",
        "noExplicitAny": "info",
        "useIterableCallbackReturn": "off",
        "noUnknownAtRules": "error",
        "noVar": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@/components",
                  "@/components/**",
                  "@/utils",
                  "@/utils/**",
                  "@/hooks/**",
                  "@/instances/**",
                  "@/app/actions",
                  "@/app/actions/**"
                ],
                "message": "Use the canonical path aliases (@/element, @/module, @/feature, @/layout, @/util, @/hook, @/instance, @/action)."
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "lineWidth": 120
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              "next",
              "next/**",
              ":BLANK_LINE:",
              "react",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              "@/feature/**",
              ":BLANK_LINE:",
              "@/layout/**",
              ":BLANK_LINE:",
              "@/module/**",
              ":BLANK_LINE:",
              "@/element/**",
              ":BLANK_LINE:",
              "@/icon/**",
              ":BLANK_LINE:",
              "@/schema/**",
              ":BLANK_LINE:",
              "@/context/**",
              ":BLANK_LINE:",
              "@/wrapper/**",
              ":BLANK_LINE:",
              "@/hook/**",
              ":BLANK_LINE:",
              "@/class/**",
              ":BLANK_LINE:",
              "@/instance/**",
              ":BLANK_LINE:",
              "@/util/**",
              ":BLANK_LINE:",
              "@/constant/**",
              ":BLANK_LINE:",
              "@/type/**",
              ":BLANK_LINE:",
              "@/image/**",
              ":BLANK_LINE:",
              "@/font/**",
              ":BLANK_LINE:",
              "@/**"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/elements/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/module/**", "@/feature/**", "@/layout/**"],
                    "message": "Elements must not import modules, layouts or features (layer boundary)."
                  },
                  {
                    "group": [
                      "@/components",
                      "@/components/**",
                      "@/utils",
                      "@/utils/**",
                      "@/hooks/**",
                      "@/instances/**",
                      "@/app/actions",
                      "@/app/actions/**"
                    ],
                    "message": "Use the canonical path aliases (@/element, @/module, @/feature, @/layout, @/util, @/hook, @/instance, @/action)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/modules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/feature/**", "@/layout/**"],
                    "message": "Modules must not import layouts or features (layer boundary)."
                  },
                  {
                    "group": [
                      "@/components",
                      "@/components/**",
                      "@/utils",
                      "@/utils/**",
                      "@/hooks/**",
                      "@/instances/**",
                      "@/app/actions",
                      "@/app/actions/**"
                    ],
                    "message": "Use the canonical path aliases (@/element, @/module, @/feature, @/layout, @/util, @/hook, @/instance, @/action)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
