    "_db:raw-empty-migration": "cross-env NODE_ENV=production drizzle-kit generate --custom",
    "_db:raw-generate": "cross-env NODE_ENV=production drizzle-kit generate",
    "_db:format": "biome format --write drizzle",
    "_test:e2e:ci": "cypress run",
    "_test:e2e:open": "cypress open",
    "test:e2e:install": "cypress install",
    "test:e2e": "cross-env NODE_ENV=test tsx tests/runners/e2e.ts",
    "test:e2e:up": "cross-env NODE_ENV=test tsx tests/runners/e2e.ts up",
    "test:e2e:run": "cross-env NODE_ENV=test tsx tests/runners/e2e.ts run",
    "test:e2e:down": "cross-env NODE_ENV=test tsx tests/runners/e2e.ts down",
    "test:e2e:status": "cross-env NODE_ENV=test tsx tests/runners/e2e.ts status",
    "test:integration": "cross-env NODE_ENV=test tsx tests/runners/integration.ts",
    "test:integration:up": "cross-env NODE_ENV=test tsx tests/runners/integration.ts up",
    "test:integration:run": "cross-env NODE_ENV=test tsx tests/runners/integration.ts run",
    "test:integration:down": "cross-env NODE_ENV=test tsx tests/runners/integration.ts down",
    "test:integration:status": "cross-env NODE_ENV=test tsx tests/runners/integration.ts status",
    "test:unit": "vitest run --config vitest.unit.config.mts --reporter=verbose"
  },
